# 1 "../include/circle/spinlock.h" 1
# 54 "../include/circle/spinlock.h"
class CSpinLock
{
public:
 CSpinLock (unsigned nTargetLevel = 1)
 : m_nTargetLevel (nTargetLevel)
 {
 }

 void Acquire (void)
 {
  if (m_nTargetLevel >= 1)
  {
   EnterCritical (m_nTargetLevel);
  }
 }

 void Release (void)
 {
  if (m_nTargetLevel >= 1)
  {
   LeaveCritical ();
  }
 }

private:
 unsigned m_nTargetLevel;
};
